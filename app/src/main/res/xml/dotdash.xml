<?xml version="1.0" encoding="utf-8"?>
<!--
  点点划键盘 · 主键盘布局

  版式（每行键宽合计 100%）：
    Row1: [，16%]  [ · 点  42% ] [ – 划  42% ]
    Row2: [。16%]  [ ；分号 42%] [ ⌫ 退格 42%]
    Row3: [？16%]  [   空格   84%]
    Row4: [！16%]  [ 中⇄英 42%] [ 符   42%]

  左侧第 1 列纵向固定 4 个常用符号：，。？！
  （上方候选区会显示候选词/拼音；符号面板由底部"符"键展开。）

  键码约定见 net.iowaline.dotdash.cn.DotDashIMEService：
    0/1 = 点/划（沿用 DotDash 原约定）
    32  = 空格，67 = 退格
    -200 分号（强制分割当前点划序列）
    -201 中/英切换，-202 打开符号面板
-->
<Keyboard
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:horizontalGap="6dp"
    android:verticalGap="6dp">

    <Row
        android:keyHeight="62dp"
        android:rowEdgeFlags="top">
        <Key
            android:keyLabel="，"
            android:keyEdgeFlags="left"
            android:keyWidth="16%"
            android:codes="65292" />
        <Key
            android:keyLabel="·"
            android:keyWidth="42%"
            android:codes="0" />
        <Key
            android:keyLabel="–"
            android:keyWidth="42%"
            android:codes="1"
            android:keyEdgeFlags="right" />
    </Row>

    <Row android:keyHeight="56dp">
        <Key
            android:keyLabel="。"
            android:keyEdgeFlags="left"
            android:keyWidth="16%"
            android:codes="12290" />
        <Key
            android:keyLabel="；"
            android:keyWidth="42%"
            android:codes="-200" />
        <Key
            android:keyLabel="⌫"
            android:keyWidth="42%"
            android:codes="67"
            android:isRepeatable="true"
            android:keyEdgeFlags="right" />
    </Row>

    <Row android:keyHeight="52dp">
        <Key
            android:keyLabel="？"
            android:keyEdgeFlags="left"
            android:keyWidth="16%"
            android:codes="65311" />
        <Key
            android:keyLabel="空格"
            android:keyWidth="84%"
            android:codes="32"
            android:keyEdgeFlags="right" />
    </Row>

    <Row
        android:keyHeight="52dp"
        android:rowEdgeFlags="bottom">
        <Key
            android:keyLabel="！"
            android:keyEdgeFlags="left"
            android:keyWidth="16%"
            android:codes="65281" />
        <Key
            android:keyLabel="中"
            android:keyWidth="42%"
            android:codes="-201" />
        <Key
            android:keyLabel="符"
            android:keyWidth="42%"
            android:codes="-202"
            android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
